{
  "name": "pi-edit-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic benchmark comparing pi-coding-agent file-editing extensions: built-in edit, hashline tools, and the standard edit tool.",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench:llm": "bun run src/main-llm.ts",
    "bench:llm:pro-diff1": "bun run src/main-llm.ts --contenders pi-hashline-edit-pro --out results/llm-pro-diff1.md"
  },
  "dependencies": {
    "@agimon-ai/doompi-edit": "^0.0.1-alpha.49",
    "@agimon-ai/doompi-grep": "^0.0.1-alpha.49",
    "@agimon-ai/doompi-read": "^0.0.1-alpha.49",
    "@cortexkit/aft": "^0.57.1",
    "@cortexkit/aft-pi": "^0.57.1",
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@mariozechner/pi-ai": "^0.73.1",
    "@sinclair/typebox": "^0.34.52",
    "@xynogen/pix-edit": "^0.2.5",
    "@xynogen/pix-pretty": "^1.26.0",
    "@xynogen/pix-runtime": "^0.10.1",
    "pi-edit-guard": "^0.1.4",
    "pi-hashline-edit-pro": "^4.3.5",
    "pi-hashline-readmap": "^0.14.0",
    "pi-semantic-edit": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
