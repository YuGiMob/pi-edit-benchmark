    "@mariozechner/pi-ai": "^0.73.1",
    "@oh-my-pi/hashline": "^18.0.10",
    "@sinclair/typebox": "^0.34.52",
    "@the-agency/pi-hashline-edit": "^0.2.1",
    "@xynogen/pix-edit": "^0.2.2",
    "@xynogen/pix-pretty": "^1.18.4",
    "@xynogen/pix-runtime": "^0.8.1",
    "pi-hashline-context-edit": "^0.11.0",
    "pi-hashline-edit": "^0.8.3",
